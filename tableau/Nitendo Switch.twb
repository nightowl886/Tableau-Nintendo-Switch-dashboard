              <groupfilter function='level-members' level='[tqr:release_date (copy)_5211786628702208:ok]' />
              <groupfilter function='member' level='[tqr:release_date (copy)_5211786628702208:ok]' member='%null%' />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.05qxuev02li0d31bcwe4u1yudw4x].[tqr:release_date (copy)_5211786628702208:ok]</column>
