          <datasources>
            <datasource caption='工作表 1 - switch-games (switch-games)' name='federated.05qxuev02li0d31bcwe4u1yudw4x' />
          </datasources>
          <datasource-dependencies datasource='federated.05qxuev02li0d31bcwe4u1yudw4x'>
            <column-instance column='[image_url]' derivation='Attribute' name='[attr:image_url:nk]' pivot='key' type='nominal' />
            <column-instance column='[review_conclusion]' derivation='Attribute' name='[attr:review_conclusion:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[image_url]' role='dimension' type='nominal' />
            <column-instance column='[num_votes]' derivation='None' name='[none:num_votes:qk]' pivot='key' type='quantitative' />
            <column-instance column='[title]' derivation='None' name='[none:title:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[num_votes]' role='measure' type='quantitative' />
            <column-instance column='[rating]' derivation='Sum' name='[rank:sum:rating:ok:4]' pivot='key' type='ordinal'>
              <table-calc ordering-type='Columns' rank-options='Unique,Ascending' type='Rank' />
            </column-instance>
            <column datatype='real' name='[rating]' role='measure' type='quantitative' />
            <column datatype='string' name='[review_conclusion]' role='dimension' type='nominal' />
            <column-instance column='[num_votes]' derivation='Sum' name='[sum:num_votes:qk]' pivot='key' type='quantitative' />
            <column-instance column='[rating]' derivation='Sum' name='[sum:rating:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[title]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.05qxuev02li0d31bcwe4u1yudw4x].[none:num_votes:qk]' included-values='in-range'>
            <min>200</min>
          </filter>
          <filter class='categorical' column='[federated.05qxuev02li0d31bcwe4u1yudw4x].[rank:sum:rating:ok:4]'>
            <groupfilter function='union' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[rank:sum:rating:ok:4]' member='1' />
              <groupfilter function='member' level='[rank:sum:rating:ok:4]' member='2' />
              <groupfilter function='member' level='[rank:sum:rating:ok:4]' member='3' />
              <groupfilter function='member' level='[rank:sum:rating:ok:4]' member='4' />
