            <column datatype='string' name='[title]' role='dimension' type='nominal' />
            <column-instance column='[release_date (copy)_5211786628702208]' derivation='Quarter-Trunc' name='[tqr:release_date (copy)_5211786628702208:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
