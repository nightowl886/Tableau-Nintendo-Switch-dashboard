            <column caption='Date' datatype='date' datatype-customized='true' name='[release_date (copy)_5211786628702208]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(IF NOT ISNULL( DATEPARSE ( &quot;dd&apos;th&apos; MMM yyyy&quot;, [release_date] )  ) &#10;THEN DATEPARSE ( &quot;dd&apos;th&apos; MMM yyyy&quot;, [release_date] ) &#10;  &#10;ELSEIF NOT ISNULL ( DATEPARSE ( &quot;dd&apos;nd&apos; MMM yyyy&quot;, [release_date] )  ) &#10;THEN DATEPARSE ( &quot;dd&apos;nd&apos; MMM yyyy&quot;, [release_date] ) &#10;  &#10;ELSEIF NOT ISNULL ( DATEPARSE ( &quot;dd&apos;rd&apos; MMM yyyy&quot;, [release_date] )  ) &#10;THEN DATEPARSE ( &quot;dd&apos;rd&apos; MMM yyyy&quot;, [release_date] ) &#10;&#10;  &#10;ELSEIF NOT ISNULL ( DATEPARSE ( &quot;dd&apos;st&apos; MMM yyyy&quot;, [release_date] )  ) &#10;THEN DATEPARSE ( &quot;dd&apos;st&apos; MMM yyyy&quot;, [release_date] ) &#10; &#10;END)' />
            </column>
